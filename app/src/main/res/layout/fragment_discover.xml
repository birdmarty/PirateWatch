<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.DiscoverFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Combined search bar and site selector container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingHorizontal="10dp">

            <!-- Search and Spinners Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Search"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <Spinner
                    android:id="@+id/categorySpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="0.35"
                    android:entries="@array/OneThree_category_options"
                    android:padding="4dp"
                    android:minHeight="48dp"
                    android:spinnerMode="dropdown"
                    android:theme="@style/SpinnerTheme" />

                <Spinner
                    android:id="@+id/sortSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="0.35"
                    android:entries="@array/OneThree_sort_options"
                    android:padding="4dp"
                    android:minHeight="48dp"
                    android:spinnerMode="dropdown"
                    android:theme="@style/SpinnerTheme" />
            </LinearLayout>

            <!-- Website Selector Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:background="@color/design_default_color_primary"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/tv1337x"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/accent"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_1337x" />

                <ImageView
                    android:id="@+id/tvLimeTorrents"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/accent"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_limetorrents" />
            </LinearLayout>
        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/loadingIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/loading"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>